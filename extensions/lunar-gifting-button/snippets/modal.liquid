<div id="lunar-gift-modal" class="gift-modal">
  <div class="gift-modal-content" role="dialog" aria-modal="true" aria-labelledby="lunar-gift-modal-title">
    <button id="lunar-modal-close" class="gift-close" type="button" aria-label="Close gift details modal">
      &times;
    </button>

    <div class="gift-modal-header">
      <span class="gift-modal-kicker">Lunar Gifting</span>
      <h3 id="lunar-gift-modal-title">Send as a Gift</h3>
      <p>Add the recipient details and a message for this order.</p>
    </div>

    <form id="gift-form">
      <div class="gift-field">
        <label for="lunar-gift-recipient">Recipient Name</label>
        <input
          id="lunar-gift-recipient"
          type="text"
          name="gift_recipient"
          autocomplete="name"
          aria-describedby="lunar-gift-recipient-error"
          required
        >
        <p id="lunar-gift-recipient-error" class="gift-field-error" aria-live="polite"></p>
      </div>

      <div class="gift-field">
        <label for="lunar-gift-email">Recipient Email</label>
        <input
          id="lunar-gift-email"
          type="email"
          name="gift_email"
          autocomplete="email"
          aria-describedby="lunar-gift-email-error"
          required
        >
        <p id="lunar-gift-email-error" class="gift-field-error" aria-live="polite"></p>
      </div>

      <div class="gift-field">
        <label for="lunar-gift-message">Gift Message</label>
        <textarea
          id="lunar-gift-message"
          name="gift_message"
          rows="4"
          aria-describedby="lunar-gift-message-error"
          required
        ></textarea>
        <p id="lunar-gift-message-error" class="gift-field-error" aria-live="polite"></p>
      </div>

      <button
        id="lunar-save-gift-details"
        class="gift-save-button"
        data-product-id="{{ product.id }}"
        data-product-description="{{ product.description }}"
        data-product-price="{{ product.price }}"
        data-variant-id="{{ product.variants.first.id }}"
      >
        Save Gift Details
      </button>
    </form>
  </div>
</div>

<style>
  .gift-button {
    padding: 10px 16px;
    cursor: pointer;
  }

  .gift-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    padding: 24px;
    overflow-y: auto;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.48);
    backdrop-filter: blur(2px);
  }

  .gift-modal-content {
    position: relative;
    background: rgb(var(--color-background, 255, 255, 255));
    color: rgb(var(--color-foreground, 18, 18, 18));
    padding: 32px;
    margin: min(10vh, 72px) auto;
    width: min(100%, 460px);
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.12);
    border-radius: var(--popup-corner-radius, 8px);
    box-shadow: 0 24px 70px rgba(var(--color-shadow, 18, 18, 18), 0.22);
  }

  .gift-modal-header {
    padding-right: 36px;
    margin-bottom: 24px;
  }

  .gift-modal-kicker {
    display: block;
    margin-bottom: 8px;
    color: rgba(var(--color-foreground, 18, 18, 18), 0.68);
    font-size: 1.2rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .gift-modal-header h3 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 1.1;
  }

  .gift-modal-header p {
    margin: 10px 0 0;
    color: rgba(var(--color-foreground, 18, 18, 18), 0.72);
    font-size: 1.4rem;
    line-height: 1.45;
  }

  .gift-close {
    position: absolute;
    right: 18px;
    top: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.06);
    color: rgb(var(--color-foreground, 18, 18, 18));
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .gift-close:hover,
  .gift-close:focus-visible {
    background: rgba(var(--color-foreground, 18, 18, 18), 0.12);
  }

  #gift-form {
    display: grid;
    gap: 16px;
  }

  .gift-field label {
    display: block;
    margin-bottom: 6px;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
  }

  #gift-form input,
  #gift-form textarea {
    width: 100%;
    min-height: 44px;
    padding: 11px 12px;
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.22);
    border-radius: var(--inputs-radius, 4px);
    background: rgb(var(--color-background, 255, 255, 255));
    color: rgb(var(--color-foreground, 18, 18, 18));
    font: inherit;
  }

  #gift-form textarea {
    min-height: 112px;
    resize: vertical;
  }

  #gift-form input:focus,
  #gift-form textarea:focus {
    border-color: rgba(var(--color-button, 18, 18, 18), 0.8);
    box-shadow: 0 0 0 2px rgba(var(--color-button, 18, 18, 18), 0.14);
    outline: 0;
  }

  #gift-form input[aria-invalid='true'],
  #gift-form textarea[aria-invalid='true'] {
    border-color: #b3261e;
    box-shadow: 0 0 0 2px rgba(179, 38, 30, 0.12);
  }

  .gift-field-error {
    display: none;
    margin: 6px 0 0;
    color: #b3261e;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .gift-field-error.is-visible {
    display: block;
  }

  .gift-save-button {
    min-height: 48px;
    margin-top: 4px;
    padding: 12px 20px;
    border: var(--buttons-border-width, 1px) solid rgba(var(--color-button, 18, 18, 18), var(--buttons-border-opacity, 1));
    border-radius: var(--buttons-radius, 0);
    background: rgba(var(--color-button, 18, 18, 18), 1);
    color: rgb(var(--color-button-text, 255, 255, 255));
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .gift-save-button:hover,
  .gift-save-button:focus-visible {
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .gift-modal {
      padding: 16px;
    }

    .gift-modal-content {
      padding: 24px;
      margin: 48px auto;
    }
  }
</style>

<script async src="{{ 'saveGiftDetails.js' | asset_url }}"></script>

<script>
  const lunarGiftModal = document.getElementById('lunar-gift-modal');
  function closeModal() {
    lunarGiftModal.style.display = 'none';
  }

  const modalClose = document.getElementById('lunar-modal-close');
  modalClose.addEventListener('click', function (event) {
    event.preventDefault();
    closeModal();
  });

  const giftForm = document.getElementById('gift-form');
  const saveGiftDetailsButton = document.getElementById('lunar-save-gift-details');
  const giftFields = [
    {
      input: document.getElementById('lunar-gift-recipient'),
      error: document.getElementById('lunar-gift-recipient-error'),
      requiredMessage: 'Enter the recipient name.',
    },
    {
      input: document.getElementById('lunar-gift-email'),
      error: document.getElementById('lunar-gift-email-error'),
      requiredMessage: 'Enter the recipient email address.',
      invalidMessage: 'Enter a valid email address.',
    },
    {
      input: document.getElementById('lunar-gift-message'),
      error: document.getElementById('lunar-gift-message-error'),
      requiredMessage: 'Enter a gift message.',
    },
  ];

  function setFieldError(field, message) {
    field.input.setAttribute('aria-invalid', message ? 'true' : 'false');
    field.error.textContent = message;
    field.error.classList.toggle('is-visible', Boolean(message));
  }

  function resetGiftFormState() {
    giftForm.reset();
    giftFields.forEach(function (field) {
      setFieldError(field, '');
    });
  }

  window.resetLunarGiftForm = resetGiftFormState;

  function validateGiftField(field) {
    const value = field.input.value.trim();
    let message = '';

    if (!value) {
      message = field.requiredMessage;
    } else if (field.input.type === 'email' && !field.input.validity.valid) {
      message = field.invalidMessage;
    }

    setFieldError(field, message);
    return !message;
  }

  giftFields.forEach(function (field) {
    field.input.addEventListener('input', function () {
      validateGiftField(field);
    });

    field.input.addEventListener('blur', function () {
      validateGiftField(field);
    });
  });

  giftForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const isValid = giftFields.map(validateGiftField).every(Boolean);

    if (!isValid) {
      const firstInvalidField = giftFields.find(function (field) {
        return field.input.getAttribute('aria-invalid') === 'true';
      });
      firstInvalidField.input.focus();
      return;
    }

    await window.saveGiftDetailsAndAddToCart(giftForm, saveGiftDetailsButton.dataset.variantId);
    resetGiftFormState();
    closeModal();
  });
</script>
