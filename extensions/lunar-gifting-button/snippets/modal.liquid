<div id="lunar-gift-modal" class="gift-modal">
  <div class="gift-modal-content">
    <span id="lunar-modal-close" class="gift-close">&times;</span>

    <h3>Send as a Gift</h3>

    <form id="gift-form" submit="">
      <label>
        Recipient Name
        <input type="text" name="gift_recipient" required>
      </label>

      <label>
        Recipient Email
        <input type="email" name="gift_email">
      </label>

      <label>
        Gift Message
        <textarea name="gift_message"></textarea>
      </label>

      <button
        id="lunar-save-gift-details"
        data-product-id="{{ product.id }}"
        data-product-description="{{ product.description }}"
        data-product-price="{{ product.price }}"
        data-variant-id="{{ product.variants.first.id }}"
      >
        Save Gift Details
      </button>
    </form>
  </div>
</div>

<style>
  .gift-button {
    padding: 10px 16px;
    cursor: pointer;
  }

  .gift-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }

  .gift-modal-content {
    background: white;
    padding: 24px;
    margin: 10% auto;
    width: 400px;
    border-radius: 8px;
  }

  .gift-close {
    float: right;
    cursor: pointer;
    font-size: 20px;
  }

  #gift-form label {
    display: block;
    margin-bottom: 12px;
  }

  #gift-form input,
  #gift-form textarea {
    width: 100%;
    padding: 6px;
  }
</style>

<script async src="{{ 'saveGiftDetails.js' | asset_url }}"></script>

<script>
  const lunarGiftModal = document.getElementById('lunar-gift-modal');
  function closeModal() {
    lunarGiftModal.style.display = 'none';
  }

  const modalClose = document.getElementById('lunar-modal-close');
  modalClose.addEventListener('click', function (event) {
    event.preventDefault();
    closeModal();
  });

  document.getElementById('lunar-save-gift-details').addEventListener('click', function (e) {
    console.log('e', e);
    e.preventDefault();
    saveGiftDetailsAndAddToCart(e.target.form, this.dataset.variantId);
    closeModal();
  });
</script>
